---
interface Event {
  frontmatter: {
    title: string;
    date: string;
  };
  compiledContent: () => string;
}

const events: Event[] = Object.values(
  await import.meta.glob("../../events/*.md", { eager: true })
);

const mappedEvents = events.map((event) => ({
  frontmatter: event.frontmatter,
  compiledContent: event.compiledContent(),
}));

---

<section class="events">
  <h2>Arrangementer</h2>
  <event-list data-events={JSON.stringify(mappedEvents)} data-filter="future"></event-list>
  <event-list data-title="Tidligere arrangementer" data-events={JSON.stringify(mappedEvents)} data-filter="past"></event-list>

  <script type="module">
    class EventList extends HTMLElement {
      connectedCallback() {
        const events = JSON.parse(this.dataset.events);
        const filterType = this.dataset.filter;
        const title = this.dataset.title;
        const now = new Date();

        const sortByLatest = (a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date);
        const sortByUpcoming = (a, b) => new Date(a.frontmatter.date) - new Date(b.frontmatter.date);

        const formatDate = (date) =>
          new Date(date).toLocaleDateString("no-NO", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });

        const filteredEvents = events
          .filter(event => (filterType === "future" ? new Date(event.frontmatter.date) >= now : new Date(event.frontmatter.date) < now))
          .sort(filterType === "future" ? sortByUpcoming : sortByLatest);

        this.innerHTML = `
          ${title ? `<h3>${title}</h3>` : ''}
          ${filteredEvents.length === 0 ? `<p>Ingen ${filterType === "future" ? "arrangementer planlagt for øyeblikket" : "tidligere arrangementer"}</p>` : `
            <ol>
              ${filteredEvents
                .map(
                  event => `
                    <li>
                      <details>
                        <summary>
                          <span>${event.frontmatter.title}</span>
                          <p>${formatDate(event.frontmatter.date)}</p>
                        </summary>
                        <article>
                          ${event.compiledContent}
                        </article>
                      </details>
                    </li>`
                )
                .join('')}
            </ol>
          `}
        `;
      }
    }

    customElements.define('event-list', EventList);
  </script>
</section>
